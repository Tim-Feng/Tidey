#!/usr/bin/env bash
# Claude hook dispatch: journals the typed hook event as ONE compact JSONL
# envelope for the Remote Bridge, then forwards the untouched stdin payload
# to the tidey CLI (Mac sidebar path).
#
# Envelope (v3): {"v":3,"event":…,"ts":…,"epoch":…,"event_id":…,"seq":…,"payload_b64":…}
#  - payload_b64: base64 of the RAW stdin bytes — pretty-printed/multiline
#    hook JSON can never break the journal's line framing.
#  - epoch: one wrapper instance (pid+start time). The Bridge adopts the
#    newest epoch and rejects a retired wrapper's late events.
#  - event_id: unique per delivery, for duplicate rejection.
#  - seq: per-journal monotonic counter. Allocated AND appended inside the
#    SAME lock-held critical section — the seq order and the file order of
#    lines are therefore always identical.
#
# Implicit-resume support: when the wrapper could not trust an explicit
# session id ahead of time (`-c`, bare `--resume`, a non-UUID --resume
# search term, or --fork-session), JOURNAL is passed empty and
# REGISTRY_ROOT is passed instead. Every Claude Code hook payload carries
# the CURRENT session_id, so this script discovers it from ITS OWN
# invocation's stdin and lazily claims the journal (and, the first time,
# the registry file) at the now-known path — no special-casing of which
# hook fires first.

set -uo pipefail

EVENT="${1:-}"
JOURNAL="${2:-}"
EPOCH="${3:-}"
REGISTRY_ROOT="${4:-}"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
TIDEY_BIN="$HOOK_DIR/tidey"
# shellcheck source=/dev/null
source "$HOOK_DIR/claude-hook-journal-lifecycle"

if [[ -z "$EVENT" ]]; then
    exit 0
fi

# Temporary diagnostics (remove after the hook-termination investigation):
# one `start` line before anything else, one `journal` line after the journal
# write, one `end` line after forwarding. A pid with `start` and no `end` was
# terminated mid-hook, whatever the signal (SIGKILL included). Single O_APPEND
# writes well under PIPE_BUF, so concurrent hooks never interleave; no lock.
DIAG_LOG=""
if [[ -n "$JOURNAL" ]]; then
    DIAG_LOG="${JOURNAL%/*}/claude-hook-diagnostics.log"
elif [[ -n "$REGISTRY_ROOT" ]]; then
    DIAG_LOG="$REGISTRY_ROOT/claude-hook-diagnostics.log"
fi
DIAG_START_TS="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
diag_line() {
    [[ -n "$DIAG_LOG" ]] || return 0
    printf '%s %s %s %s %s%s\n' "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" "$1" "${EVENT:-?}" "$$" "$PPID" "${2:+ $2}" \
        >> "$DIAG_LOG" 2>/dev/null || true
}
if [[ -n "$DIAG_LOG" ]]; then
    printf '%s start %s %s %s\n' "$DIAG_START_TS" "${EVENT:-?}" "$$" "$PPID" >> "$DIAG_LOG" 2>/dev/null || true
fi

PAYLOAD="$(cat 2>/dev/null || true)"

extract_json_string_field() {
    # Minimal, dependency-free string-field extractor: good enough for the
    # flat top-level fields Claude Code hook payloads carry (session_id,
    # cwd). Not a general JSON parser.
    local json="$1" field="$2"
    printf '%s' "$json" | sed -n "s/.*\"${field}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n1
}

json_escape_field() {
    local s="${1-}"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

_hook_test_pause() {
    # Test-only pause point (inert unless the test env names this point).
    # Waits with the builtin `read -t` on a caller-provided FIFO, so no child
    # process inherits the lock fd while the test kills or probes the writer.
    [[ -n "${TIDEY_HOOK_TEST_PAUSE_AT:-}" && "$TIDEY_HOOK_TEST_PAUSE_AT" == "$1" ]] || return 0
    [[ -n "${TIDEY_HOOK_TEST_PAUSE_MARKER:-}" ]] && : > "$TIDEY_HOOK_TEST_PAUSE_MARKER"
    [[ -p "${TIDEY_HOOK_TEST_PAUSE_FIFO:-}" ]] || return 0
    exec 8<> "$TIDEY_HOOK_TEST_PAUSE_FIFO"
    read -r -t "${TIDEY_HOOK_TEST_PAUSE_SECONDS:-5}" -u 8 _ || true
    exec 8<&-
}

JOURNAL_RESULT="no_journal"

append_journal_line() {
    # Allocates the next seq and appends the envelope in ONE critical
    # section, so seq order == append order for every writer. The mutex is a
    # kernel flock on fd 9 (lockf(1) locks the open file that fd 9 names and
    # the lock outlives the short-lived lockf process): the kernel releases it
    # when the holder dies, so a killed hook can never leave a stale lock.
    # Rules that keep the lock from leaking:
    #   - fd 9 is fixed (bash 3.2 has no `{fd}` allocation);
    #   - every return path closes fd 9 first;
    #   - inside the critical section only builtins run, plus `mv`/`rm`,
    #     which get `9>&-` so no child inherits the lock.
    # The seq file is replaced BEFORE the line is appended: a writer killed
    # between the two leaves a seq gap (the Bridge tolerates gaps) instead of
    # a reused seq (the Bridge drops the later duplicate).
    # On lock starvation (2 s; lockf -t takes whole seconds) the write is
    # skipped rather than risking an out-of-order append. 1 s proved too tight
    # under a 50-process burst; SessionEnd's 1 s hook timeout may cut the wait
    # short, which is safe because the kernel drops the killed waiter's fd.
    local journal="$1" line="$2"
    local seq_file="$journal.seq"
    local lock_file="$journal.lock"
    local seq tmp
    exec 9>> "$lock_file" || { JOURNAL_RESULT="lock_open_failed"; return 1; }
    if ! /usr/bin/lockf -s -t 2 9; then
        exec 9>&-
        JOURNAL_RESULT="lock_timeout"
        return 1
    fi
    _hook_test_pause in_lock
    seq=0
    IFS= read -r seq 2>/dev/null < "$seq_file" || true
    case "$seq" in (*[!0-9]*|'') seq=0 ;; esac
    seq=$((seq + 1))
    tmp="$seq_file.tmp.$$"
    if ! { printf '%s' "$seq" > "$tmp" && /bin/mv -f "$tmp" "$seq_file" 9>&-; } 2>/dev/null; then
        /bin/rm -f "$tmp" 9>&- 2>/dev/null
        exec 9>&-
        JOURNAL_RESULT="seq_write_failed"
        return 1
    fi
    _hook_test_pause after_seq
    printf '%s\n' "${line/__SEQ__/$seq}" >> "$journal" 2>/dev/null || true
    exec 9>&-
    JOURNAL_RESULT="ok"
    return 0
}


# Implicit-resume lazy discovery: derive the journal path (and, if this is
# the first time the id is seen, the registry file) from THIS payload's
# session_id.
if [[ -z "$JOURNAL" && -n "$REGISTRY_ROOT" ]]; then
    discovered_id="$(extract_json_string_field "$PAYLOAD" "session_id")"
    if [[ -z "$discovered_id" ]]; then
        discovered_id="$(extract_json_string_field "$PAYLOAD" "sessionId")"
    fi
    if [[ -n "$discovered_id" ]]; then
        mkdir -p "$REGISTRY_ROOT" 2>/dev/null || true
        JOURNAL="$REGISTRY_ROOT/claude-hooks-${discovered_id}.jsonl"
        MARKER="$REGISTRY_ROOT/claude-hooks-${discovered_id}.epoch"
        claude_hook_journal_claim "$MARKER" "$EPOCH"

        registry_file="$REGISTRY_ROOT/claude-${discovered_id}.json"
        if [[ -n "${TIDEY_WORKSPACE_ID:-}" && ! -f "$registry_file" ]]; then
            tmp_registry="$(mktemp "$REGISTRY_ROOT/.claude-registry.XXXXXX" 2>/dev/null || true)"
            if [[ -n "$tmp_registry" ]]; then
                cwd_field="$(extract_json_string_field "$PAYLOAD" "cwd")"
                created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
                printf '{"version":1,"vendor":"claude","workspace_id":"%s","session_id":"%s","panel_id":"%s","pid":%s,"cwd":"%s","created_at":"%s"}\n' \
                    "$(json_escape_field "${TIDEY_WORKSPACE_ID:-}")" \
                    "$(json_escape_field "$discovered_id")" \
                    "$(json_escape_field "${TIDEY_PANEL_ID:-}")" \
                    "${TIDEY_CLAUDE_WRAPPER_PID:-0}" \
                    "$(json_escape_field "${cwd_field:-${TIDEY_CLAUDE_WRAPPER_CWD:-}}")" \
                    "$created_at" > "$tmp_registry" 2>/dev/null \
                    && mv -f "$tmp_registry" "$registry_file" 2>/dev/null \
                    || rm -f "$tmp_registry"
            fi
        fi
    fi
fi

if [[ -n "$JOURNAL" ]]; then
    ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    event_id="$(uuidgen 2>/dev/null || echo "$$-$RANDOM")"
    payload_b64="$(printf '%s' "$PAYLOAD" | base64 2>/dev/null | tr -d '\n')"
    template="{\"v\":3,\"event\":\"$EVENT\",\"ts\":\"$ts\",\"epoch\":\"${EPOCH:-unknown}\",\"event_id\":\"$event_id\",\"seq\":__SEQ__,\"payload_b64\":\"$payload_b64\"}"
    append_journal_line "$JOURNAL" "$template" || true
fi
diag_line journal "result=$JOURNAL_RESULT"

cli_status=0
if [[ -x "$TIDEY_BIN" ]]; then
    printf '%s' "$PAYLOAD" | "$TIDEY_BIN" claude-hook "$EVENT"
    cli_status=$?
fi
diag_line end "cli=$cli_status"
exit "$cli_status"
