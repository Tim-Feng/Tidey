#!/usr/bin/env bash
# Shared argv classification for the Claude wrapper and its tests.
#
# Claude Code CLI facts this MUST respect:
#  - `-c` / `--continue` is a BOOLEAN flag. It never takes a value — the
#    token that follows it (if any) is an ordinary positional arg (often
#    the prompt), never a session id.
#  - `-r` / `--resume [value]` takes an OPTIONAL value. When present, the
#    value may be a session id OR an interactive-picker SEARCH TERM — it is
#    only trustworthy as an id when it is actually a UUID.
#  - `--session-id <uuid>` / `--resume=<uuid>` are the only forms that name
#    an id we may synthesize/trust directly, and only when the value is a
#    UUID.
#  - `--fork-session` makes Claude Code mint a NEW session id distinct from
#    the resumed one — the id is unknowable ahead of time regardless of
#    what --resume/--continue named.

claude_hook_looks_like_uuid() {
    [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

# Prints a TRUSTED explicit session id and returns 0, or returns 1 when no
# argv form names one we may trust ahead of time.
claude_hook_find_explicit_session_id() {
    [[ $# -gt 0 ]] || return 1
    local args=("$@")
    local i=0
    # --fork-session always mints an id we cannot know in advance,
    # regardless of WHERE it appears relative to --resume/--session-id.
    for arg in "${args[@]}"; do
        [[ "$arg" == "--fork-session" ]] && return 1
    done
    while [[ $i -lt ${#args[@]} ]]; do
        local arg="${args[$i]}"
        case "$arg" in
            --session-id=*)
                local value="${arg#--session-id=}"
                claude_hook_looks_like_uuid "$value" && printf '%s' "$value" && return 0
                ;;
            --session-id)
                if [[ $((i + 1)) -lt ${#args[@]} ]]; then
                    local next="${args[$((i + 1))]}"
                    claude_hook_looks_like_uuid "$next" && printf '%s' "$next" && return 0
                fi
                ;;
            --resume=*)
                local value="${arg#--resume=}"
                claude_hook_looks_like_uuid "$value" && printf '%s' "$value" && return 0
                ;;
            --resume|-r)
                if [[ $((i + 1)) -lt ${#args[@]} ]]; then
                    local next="${args[$((i + 1))]}"
                    # A non-flag value MAY be an id or a picker search term:
                    # only a UUID is trustworthy ahead of time.
                    if [[ "$next" != -* ]] && claude_hook_looks_like_uuid "$next"; then
                        printf '%s' "$next"
                        return 0
                    fi
                fi
                ;;
            # --continue / -c is intentionally ABSENT: it is boolean and
            # never consumes the following token as a session id.
        esac
        i=$((i + 1))
    done
    return 1
}

# True when argv resumes/continues a session WITHOUT a trusted explicit id
# (interactive picker, most-recent continuation, non-UUID search term, or
# --fork-session) — the real id is only knowable once Claude Code reports it
# via the SessionStart hook payload.
claude_hook_has_implicit_resume_flag() {
    [[ $# -gt 0 ]] || return 1
    local args=("$@")
    local i=0
    while [[ $i -lt ${#args[@]} ]]; do
        local arg="${args[$i]}"
        case "$arg" in
            --continue|-c)
                return 0  # always implicit: boolean, never carries an id
                ;;
            --fork-session)
                return 0
                ;;
            --resume|-r)
                if [[ $((i + 1)) -ge ${#args[@]} ]]; then
                    return 0  # bare --resume: interactive picker
                fi
                local next="${args[$((i + 1))]}"
                if [[ "$next" == -* ]]; then
                    return 0  # no value attached: interactive picker
                fi
                if ! claude_hook_looks_like_uuid "$next"; then
                    return 0  # non-UUID: picker search term, not a trusted id
                fi
                ;;
            --resume=*)
                local value="${arg#--resume=}"
                claude_hook_looks_like_uuid "$value" || return 0
                ;;
        esac
        i=$((i + 1))
    done
    return 1
}
