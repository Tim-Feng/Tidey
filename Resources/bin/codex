#!/usr/bin/env bash

set -euo pipefail

TIDEY_REMOTE_BRIDGE_SUPPORT_ROOT="$HOME/Library/Application Support/Tidey Remote Bridge"
REGISTRY_ROOT="$TIDEY_REMOTE_BRIDGE_SUPPORT_ROOT/agent-sessions/codex"
CODEX_RUNTIME_COMPATIBILITY_FILE="$TIDEY_REMOTE_BRIDGE_SUPPORT_ROOT/codex-runtime-compatibility.json"
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
# shellcheck source=/dev/null
source "$HOOK_DIR/tidey-tmux-pane-identity"

json_escape() {
    local s="${1-}"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

tmux_pane_id_from_env() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    fi
}

tmux_socket_path_from_env() {
    local tmux_env="${TMUX:-}"
    if [[ -n "$tmux_env" ]]; then
        printf '%s' "${tmux_env%%,*}"
    fi
}

write_registry_file() {
    local path="$1"
    local workspace_id="$2"
    local session_id="$3"
    local panel_id="$4"
    local pid="$5"
    local cwd="$6"
    local created_at="$7"
    local rollout_path="$8"
    local runtime="${9:-}"
    local app_server_socket="${10:-}"
    local app_server_pid="${11:-}"
    local remote_tui_pid="${12:-}"
    local thread_id="${13:-}"
    local resume_thread_id="${14:-}"
    local tmp_path=""
    local tmux_pane_id=""
    local tmux_socket_path=""
    local tmux_fields=""
    local runtime_fields=""

    tmux_pane_id="$(tmux_pane_id_from_env)"
    tmux_socket_path="$(tmux_socket_path_from_env)"

    if [[ -n "$tmux_pane_id" ]]; then
        tmux_fields+=",\"tmux_pane_id\":\"$(json_escape "$tmux_pane_id")\""
    fi
    if [[ -n "$tmux_socket_path" ]]; then
        tmux_fields+=",\"tmux_socket_path\":\"$(json_escape "$tmux_socket_path")\""
    fi
    if [[ -n "$runtime" ]]; then
        runtime_fields+=",\"runtime\":\"$(json_escape "$runtime")\""
    fi
    if [[ -n "$app_server_socket" ]]; then
        runtime_fields+=",\"app_server_socket\":\"$(json_escape "$app_server_socket")\""
    fi
    if [[ -n "$app_server_pid" ]]; then
        runtime_fields+=",\"app_server_pid\":$app_server_pid"
    fi
    if [[ -n "$remote_tui_pid" ]]; then
        runtime_fields+=",\"remote_tui_pid\":$remote_tui_pid"
    fi
    if [[ -n "$thread_id" ]]; then
        runtime_fields+=",\"thread_id\":\"$(json_escape "$thread_id")\""
    fi
    if [[ -n "$resume_thread_id" ]]; then
        runtime_fields+=",\"resume_thread_id\":\"$(json_escape "$resume_thread_id")\""
    fi

    mkdir -p "$REGISTRY_ROOT"
    tmp_path="$(mktemp "$REGISTRY_ROOT/.codex-registry.XXXXXX")"
    {
        printf '{"version":1,"vendor":"codex","workspace_id":"%s","session_id":"%s","panel_id":"%s","pid":%s,"cwd":"%s","created_at":"%s","rollout_path":"%s","transcript_path":"%s"%s%s}\n' \
            "$(json_escape "$workspace_id")" \
            "$(json_escape "$session_id")" \
            "$(json_escape "$panel_id")" \
            "$pid" \
            "$(json_escape "$cwd")" \
            "$(json_escape "$created_at")" \
            "$(json_escape "$rollout_path")" \
            "$(json_escape "$rollout_path")" \
            "$tmux_fields" \
            "$runtime_fields" > "$tmp_path"
        mv -f "$tmp_path" "$path"
    } || {
        rm -f "$tmp_path"
        return 1
    }
}

shell_quote() {
    local s="${1-}"
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

toml_escape() {
    json_escape "$1"
}

toml_inline_string() {
    local s="${1-}"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    printf '"%s"' "$s"
}

codex_profile_component() {
    local raw="$1"
    local sanitized=""

    sanitized="$(printf '%s' "$raw" | LC_ALL=C tr -c 'A-Za-z0-9_-' '-')"
    sanitized="${sanitized##-}"
    sanitized="${sanitized%%-}"
    if [[ -n "$sanitized" ]]; then
        printf '%s' "$sanitized"
    else
        printf 'default'
    fi
}

tmux_session_name_from_env() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        tmux display-message -p -t "$TMUX_PANE" "#{session_name}" 2>/dev/null || true
    fi
}

tidey_panel_identity_from_env() {
    if [[ -n "${TIDEY_WORKSPACE_ID:-}" && -n "${TIDEY_PANEL_ID:-}" ]]; then
        printf 'panel-%s-%s' "$TIDEY_WORKSPACE_ID" "$TIDEY_PANEL_ID"
    fi
}

codex_runtime_identity_from_env() {
    local tmux_identity=""
    tmux_identity="$(tmux_session_name_from_env)"
    if [[ -n "$tmux_identity" ]]; then
        printf '%s' "$tmux_identity"
        return 0
    fi
    tidey_panel_identity_from_env
}

stable_codex_profile_name() {
    local identity="${1:-}"

    printf 'tidey-codex-%s' "$(codex_profile_component "$identity")"
}

stable_codex_sqlite_home() {
    local real_codex_home="$1"
    local identity="${2:-}"

    if [[ -n "$identity" ]]; then
        printf '%s/.tmp/tidey-codex-sqlite-%s' "$real_codex_home" "$(codex_profile_component "$identity")"
    else
        printf '%s/.tmp/tidey-codex-sqlite-default' "$real_codex_home"
    fi
}

merge_tidey_hooks_into_user_hooks() {
    local real_codex_home="$1"
    local dispatch_script="$2"
    local hooks_path="$real_codex_home/hooks.json"
    local tmp_path=""

    mkdir -p "$real_codex_home"
    tmp_path="$(mktemp "$real_codex_home/.hooks.XXXXXX")"

    python3 - "$hooks_path" "$tmp_path" "$dispatch_script" <<'PY'
from pathlib import Path
import json
import os
import sys

hooks_path = Path(sys.argv[1])
tmp_path = Path(sys.argv[2])
dispatch_script = sys.argv[3]

def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"

root = {}
if hooks_path.exists():
    try:
        root = json.loads(hooks_path.read_text())
    except Exception:
        tmp_path.unlink(missing_ok=True)
        raise SystemExit(0)

if not isinstance(root, dict):
    root = {}

hooks = root.setdefault("hooks", {})
if not isinstance(hooks, dict):
    hooks = {}
    root["hooks"] = hooks

entries = [
    ("SessionStart", "session-start"),
    ("UserPromptSubmit", "user-prompt-submit"),
    ("Stop", "stop"),
]
changed = False

for event_name, tidey_event in entries:
    command = f"{shell_quote(dispatch_script)} {tidey_event}"

    groups = hooks.setdefault(event_name, [])
    if not isinstance(groups, list):
        groups = []
        hooks[event_name] = groups
        changed = True

    groups_changed = False
    pruned_groups = []
    for group in groups:
        if not isinstance(group, dict):
            pruned_groups.append(group)
            continue
        handlers = group.get("hooks")
        if not isinstance(handlers, list):
            pruned_groups.append(group)
            continue
        pruned_handlers = []
        for handler in handlers:
            if not isinstance(handler, dict):
                pruned_handlers.append(handler)
                continue
            handler_command = handler.get("command")
            if (
                isinstance(handler_command, str)
                and "codex-hook-dispatch" in handler_command
                and handler_command.endswith(f" {tidey_event}")
                and handler_command != command
            ):
                changed = True
                groups_changed = True
                continue
            pruned_handlers.append(handler)
        if len(pruned_handlers) != len(handlers):
            group = dict(group)
            group["hooks"] = pruned_handlers
            groups_changed = True
        if pruned_handlers:
            pruned_groups.append(group)
        else:
            changed = True
            groups_changed = True
    if groups_changed:
        hooks[event_name] = pruned_groups
        groups = pruned_groups
        changed = True

    exists = False
    for group in groups:
        if not isinstance(group, dict):
            continue
        handlers = group.get("hooks")
        if not isinstance(handlers, list):
            continue
        for handler in handlers:
            if (
                isinstance(handler, dict)
                and handler.get("type") == "command"
                and handler.get("command") == command
            ):
                exists = True
                break
        if exists:
            break

    if not exists:
        groups.append({"hooks": [{"type": "command", "command": command, "timeout": 10}]})
        changed = True

if changed or not hooks_path.exists():
    tmp_path.write_text(json.dumps(root, indent=2) + "\n")
    os.replace(tmp_path, hooks_path)
else:
    tmp_path.unlink(missing_ok=True)
PY
}

write_tidey_profile_config() {
    local real_codex_home="$1"
    local profile_name="$2"
    local sqlite_home="$3"
    local dispatch_script="$4"
    local profile_path="$real_codex_home/$profile_name.config.toml"
    local hooks_path="$real_codex_home/hooks.json"
    local tmp_path=""

    mkdir -p "$real_codex_home" "$sqlite_home"
    tmp_path="$(mktemp "$real_codex_home/.${profile_name}.config.XXXXXX")"

    python3 - "$tmp_path" "$profile_path" "$sqlite_home" "$hooks_path" "$dispatch_script" <<'PY' && mv -f "$tmp_path" "$profile_path" || {
from pathlib import Path
import hashlib
import json
import sys

tmp_path = Path(sys.argv[1])
profile_path = sys.argv[2]
sqlite_home = sys.argv[3]
hooks_path = Path(sys.argv[4])
dispatch_script = sys.argv[5]

def toml_string(value: str) -> str:
    return json.dumps(value)

def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"

def hook_hash(event_key: str, command: str, timeout: int) -> str:
    identity = {
        "event_name": event_key,
        "hooks": [
            {
                "async": False,
                "command": command,
                "timeout": timeout,
                "type": "command",
            }
        ],
    }
    payload = json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()
    return "sha256:" + hashlib.sha256(payload).hexdigest()

event_key_by_name = {
    "SessionStart": "session_start",
    "UserPromptSubmit": "user_prompt_submit",
    "Stop": "stop",
}
event_suffix_by_name = {
    "SessionStart": "session-start",
    "UserPromptSubmit": "user-prompt-submit",
    "Stop": "stop",
}

try:
    root = json.loads(hooks_path.read_text())
except Exception:
    root = {}

hooks = root.get("hooks", {}) if isinstance(root, dict) else {}
state_entries = []
for event_name, event_key in event_key_by_name.items():
    groups = hooks.get(event_name, [])
    if not isinstance(groups, list):
        continue
    expected_command = f"{shell_quote(dispatch_script)} {event_suffix_by_name[event_name]}"
    for group_index, group in enumerate(groups):
        if not isinstance(group, dict):
            continue
        handlers = group.get("hooks", [])
        if not isinstance(handlers, list):
            continue
        for handler_index, handler in enumerate(handlers):
            if not isinstance(handler, dict):
                continue
            if handler.get("type") != "command" or handler.get("command") != expected_command:
                continue
            timeout = int(handler.get("timeout", 0) or 0)
            state_key = f"{hooks_path}:{event_key}:{group_index}:{handler_index}"
            state_entries.append((state_key, hook_hash(event_key, expected_command, timeout)))

lines = [
    f"sqlite_home = {toml_string(sqlite_home)}",
    "suppress_unstable_features_warning = true",
    "",
    "[features]",
    "hooks = true",
    "",
]
for state_key, trusted_hash in state_entries:
    lines.extend([
        f"[hooks.state.{toml_string(state_key)}]",
        f"trusted_hash = {toml_string(trusted_hash)}",
        "",
    ])

tmp_path.write_text("\n".join(lines).rstrip() + "\n")
PY
        rm -f "$tmp_path"
        return 1
    }
}

resolve_real_codex_home() {
    local candidate="${CODEX_HOME:-$HOME/.codex}"
    local basename=""

    basename="$(basename "$candidate")"
    if [[ "$basename" == tidey-codex-home* ]]; then
        printf '%s' "$HOME/.codex"
        return 0
    fi

    printf '%s' "$candidate"
}

find_real_codex() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/codex" ]] && printf '%s' "$d/codex" && return 0
    done
    return 1
}

codex_installed_version_from_output() {
    local output="$1"

    if [[ "$output" =~ ^codex-cli[[:space:]]+([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
        printf '%s' "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

codex_installed_version() {
    local real_codex="$1"
    local output=""

    output="$("$real_codex" --version 2>&1)" || return 1
    codex_installed_version_from_output "$output"
}

codex_runtime_compatibility_expected_version() {
    local marker_file="${1:-}"
    local durable_id="${2:-}"
    local expected_uid="${3:-}"

    [[ -n "$marker_file" && -n "$durable_id" && "$expected_uid" =~ ^[0-9]+$ ]] || return 1
    python3 - "$marker_file" "$durable_id" "$expected_uid" <<'PY'
import json
import os
import re
import stat
import sys

path, durable_id, expected_uid_text = sys.argv[1:]
expected_uid = int(expected_uid_text)
uuid_pattern = re.compile(
    r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
)
version_pattern = re.compile(r"^[0-9]+\.[0-9]+\.[0-9]+$")


def reject():
    raise SystemExit(1)


class DuplicateJSONKey(ValueError):
    pass


def strict_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise DuplicateJSONKey(key)
        result[key] = value
    return result


if not uuid_pattern.fullmatch(durable_id):
    reject()

try:
    parent_stat = os.lstat(os.path.dirname(path))
except OSError:
    reject()
if not stat.S_ISDIR(parent_stat.st_mode):
    reject()
if parent_stat.st_uid != expected_uid or parent_stat.st_mode & 0o022:
    reject()

flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(path, flags)
except OSError:
    reject()
try:
    marker_stat = os.fstat(descriptor)
    if not stat.S_ISREG(marker_stat.st_mode):
        reject()
    if marker_stat.st_uid != expected_uid or stat.S_IMODE(marker_stat.st_mode) != 0o600:
        reject()
    if marker_stat.st_nlink != 1 or marker_stat.st_size < 1 or marker_stat.st_size > 65536:
        reject()
    chunks = []
    remaining = marker_stat.st_size + 1
    while remaining > 0:
        chunk = os.read(descriptor, remaining)
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    payload = b"".join(chunks)
finally:
    os.close(descriptor)

if len(payload) != marker_stat.st_size:
    reject()
try:
    document = json.loads(payload.decode("utf-8"), object_pairs_hook=strict_object)
except (UnicodeDecodeError, json.JSONDecodeError, DuplicateJSONKey):
    reject()

if type(document) is not dict or set(document) != {"schema_version", "tracked_plain_overrides"}:
    reject()
if type(document["schema_version"]) is not int or document["schema_version"] != 1:
    reject()
overrides = document["tracked_plain_overrides"]
if type(overrides) is not list:
    reject()

seen = set()
matched_version = None
for override in overrides:
    if type(override) is not dict or set(override) != {"session_id", "codex_version", "reason"}:
        reject()
    session_id = override["session_id"]
    codex_version = override["codex_version"]
    reason = override["reason"]
    if type(session_id) is not str or not uuid_pattern.fullmatch(session_id):
        reject()
    if type(codex_version) is not str or not version_pattern.fullmatch(codex_version):
        reject()
    if reason != "app_server_thread_read_incompatible":
        reject()
    key = (session_id, codex_version)
    if key in seen:
        reject()
    seen.add(key)
    if session_id == durable_id:
        if matched_version is not None:
            reject()
        matched_version = codex_version

if matched_version is None:
    reject()
print(matched_version)
PY
}

codex_runtime_compatibility_allows_tracked_plain() {
    local marker_file="${1:-}"
    local real_codex="${2:-}"
    local durable_id="${3:-}"
    local expected_uid="${4:-}"
    local configured_version=""
    local installed_version=""

    configured_version="$(codex_runtime_compatibility_expected_version "$marker_file" "$durable_id" "$expected_uid")" || return 1
    installed_version="$(codex_installed_version "$real_codex")" || return 1
    [[ "$configured_version" == "$installed_version" ]]
}

codex_profile_flag() {
    local real_codex="$1"
    local help_text=""

    help_text="$("$real_codex" --help 2>&1 || true)"
    case "$help_text" in
        *"--profile-v2"*)
            printf '%s' "--profile-v2"
            ;;
        *"--profile <"*|*"--profile "*)
            printf '%s' "--profile"
            ;;
        *)
            printf '%s' "--profile"
            ;;
    esac
}

rollout_for_pid() {
    local pid="$1"
    lsof -Fn -p "$pid" 2>/dev/null | sed -n 's/^n//p' | grep -E '/\.codex/sessions/.*/rollout-.*\.jsonl$' | tail -n 1
}

child_pids_for_pid() {
    local pid="$1"
    pgrep -P "$pid" 2>/dev/null || true
}

kill_pid_tree() {
    local pid="$1"
    local child=""

    [[ -n "$pid" ]] || return 0
    while IFS= read -r child; do
        [[ -n "$child" ]] || continue
        kill_pid_tree "$child"
    done < <(child_pids_for_pid "$pid")
    kill "$pid" 2>/dev/null || true
}

process_pids_matching_text() {
    local needle="$1"
    local pid=""

    [[ -n "$needle" ]] || return 0
    pgrep -f "$needle" 2>/dev/null | while IFS= read -r pid; do
        [[ -n "$pid" && "$pid" != "$$" ]] || continue
        printf '%s\n' "$pid"
    done
}

kill_processes_matching_text() {
    local needle="$1"
    local pid=""

    while IFS= read -r pid; do
        [[ -n "$pid" ]] || continue
        kill_pid_tree "$pid"
    done < <(process_pids_matching_text "$needle")
}

cleanup_stale_app_server_registry_records() {
    local cleanup_rows=""
    local registry_path=""
    local app_server_pid=""
    local remote_tui_pid=""

    mkdir -p "$REGISTRY_ROOT"
    cleanup_rows="$(python3 - "$REGISTRY_ROOT" <<'PY'
from pathlib import Path
import json
import os
import stat
import sys

root = Path(sys.argv[1])

def int_value(value):
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.isdigit():
        return int(value)
    return None

def pid_alive(pid):
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True

def socket_alive(path):
    if not isinstance(path, str) or not path:
        return False
    try:
        mode = os.stat(path).st_mode
    except OSError:
        return False
    return stat.S_ISSOCK(mode)

def normalize_socket(path):
    if not isinstance(path, str):
        return ""
    path = path.strip()
    if path.startswith("/private/tmp/"):
        return "/tmp/" + path[len("/private/tmp/"):]
    return path

def restore_id(record):
    for key in ("resume_thread_id", "thread_id", "session_id"):
        value = record.get(key)
        if isinstance(value, str) and value:
            return value
    return ""

def pane_restore_key(record):
    if record.get("vendor") != "codex":
        return None
    pane_id = record.get("tmux_pane_id")
    if not isinstance(pane_id, str) or not pane_id:
        return None
    rid = restore_id(record)
    if not rid:
        return None
    return (normalize_socket(record.get("tmux_socket_path")), pane_id, rid)

if not root.exists():
    raise SystemExit(0)

records = []
for path in root.glob("codex-*.json"):
    try:
        record = json.loads(path.read_text())
    except Exception:
        continue
    records.append((path, record))

live_app_server_keys = set()
for path, record in records:
    if record.get("runtime") not in {"codex_app_server", "codex_app_server_starting"}:
        continue

    app_server_pid = int_value(record.get("app_server_pid"))
    remote_tui_pid = int_value(record.get("remote_tui_pid"))
    app_server_socket = record.get("app_server_socket")

    stale = (
        not pid_alive(app_server_pid)
        or not socket_alive(app_server_socket)
        or (remote_tui_pid is not None and not pid_alive(remote_tui_pid))
    )
    if not stale:
        key = pane_restore_key(record)
        if key:
            live_app_server_keys.add(key)
        continue

    fields = [
        str(path),
        str(app_server_pid or ""),
        str(remote_tui_pid or ""),
    ]
    print("\t".join(fields))

for path, record in records:
    if record.get("runtime") is not None:
        continue
    key = pane_restore_key(record)
    if key and key in live_app_server_keys:
        print("\t".join([str(path), "", ""]))
PY
)"

    while IFS=$'\t' read -r registry_path app_server_pid remote_tui_pid; do
        [[ -n "$registry_path" ]] || continue
        if [[ -n "$remote_tui_pid" ]]; then
            kill_pid_tree "$remote_tui_pid"
        fi
        if [[ -n "$app_server_pid" ]]; then
            kill_pid_tree "$app_server_pid"
        fi
        rm -f "$registry_path"
    done <<< "$cleanup_rows"
}

is_uuid() {
    local value="${1:-}"
    [[ "$value" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]]
}

codex_args_contain_info_flag() {
    local arg=""

    for arg in "$@"; do
        case "$arg" in
            -h|--help|-V|--version)
                return 0
                ;;
        esac
    done
    return 1
}

app_server_resume_session_id() {
    local session_id=""

    [[ $# -ge 2 ]] || return 1
    [[ "${1:-}" == "resume" ]] || return 1
    if codex_args_contain_info_flag "$@"; then
        return 1
    fi

    session_id="${2:-}"
    is_uuid "$session_id" || return 1
    printf '%s' "$session_id" | tr '[:upper:]' '[:lower:]'
}

is_app_server_runtime_command() {
    if [[ $# -eq 0 ]]; then
        return 0
    fi
    app_server_resume_session_id "$@" >/dev/null
}

codex_rollout_path_for_session_id() {
    local real_codex_home="$1"
    local session_id="$2"
    local sessions_root="$real_codex_home/sessions"

    [[ -d "$sessions_root" ]] || return 1
    find "$sessions_root" -type f -name "rollout-*-$session_id.jsonl" -print 2>/dev/null | sort | tail -n 1
}

rollout_for_pid_tree() {
    local root_pid="$1"
    local queue=("$root_pid")
    local seen=" $root_pid "
    local pid=""
    local path=""
    local child=""

    while ((${#queue[@]} > 0)); do
        pid="${queue[0]}"
        queue=("${queue[@]:1}")

        path="$(rollout_for_pid "$pid" || true)"
        if [[ -n "$path" ]]; then
            printf '%s' "$path"
            return 0
        fi

        while IFS= read -r child; do
            [[ -n "$child" ]] || continue
            if [[ "$seen" != *" $child "* ]]; then
                seen+=" $child "
                queue+=("$child")
            fi
        done < <(child_pids_for_pid "$pid")
    done

    return 1
}

derive_session_id_from_rollout() {
    local path="$1"
    local basename="${path##*/}"
    local stem="${basename%.jsonl}"
    if [[ ${#stem} -ge 36 ]]; then
        printf '%s' "${stem: -36}"
    fi
}

monitor_rollout_and_registry() {
    local pid="$1"
    local workspace_id="$2"
    local panel_id="$3"
    local cwd="$4"
    local created_at="$5"
    local registry_file="${6:-}"
    local session_id="${7:-}"

    local rollout_path=""

    while kill -0 "$pid" 2>/dev/null; do
        local current_rollout_path=""
        local current_session_id=""
        local next_registry_file=""

        current_rollout_path="$(rollout_for_pid_tree "$pid" || true)"
        if [[ -n "$current_rollout_path" ]]; then
            current_session_id="$(derive_session_id_from_rollout "$current_rollout_path")"
        fi

        if [[ -n "$current_rollout_path" && -n "$workspace_id" && -n "$current_session_id" ]]; then
            next_registry_file="$REGISTRY_ROOT/codex-$current_session_id.json"
            if [[ -n "$registry_file" && "$registry_file" != "$next_registry_file" ]]; then
                rm -f "$registry_file"
            fi
            registry_file="$next_registry_file"
            rollout_path="$current_rollout_path"
            session_id="$current_session_id"
            write_registry_file "$registry_file" "$workspace_id" "$session_id" "$panel_id" "$pid" "$cwd" "$created_at" "$rollout_path"
        fi

        sleep 0.5
    done

    if [[ -n "$registry_file" ]]; then
        rm -f "$registry_file"
    fi
}

start_rollout_monitor_if_needed() {
    local pid="$1"
    local workspace_id="$2"
    local panel_id="$3"
    local cwd="$4"
    local created_at="$5"
    local initial_registry_file="${6:-}"
    local initial_session_id="${7:-}"

    if [[ -z "$workspace_id" ]]; then
        return 0
    fi

    monitor_rollout_and_registry "$pid" "$workspace_id" "$panel_id" "$cwd" "$created_at" "$initial_registry_file" "$initial_session_id" >/dev/null 2>&1 &
}

launch_tracked_plain_codex_runtime() {
    local real_codex="$1"
    local real_codex_home="$2"
    local profile_flag="$3"
    local profile_name="$4"
    local registry_file="$5"
    local session_id="$6"
    local created_at="$7"
    local emit_session_start_hook="$8"
    shift 8

    cleanup_stale_app_server_registry_records
    write_registry_file "$registry_file" "$TIDEY_WORKSPACE_ID" "$session_id" "${TIDEY_PANEL_ID:-}" "$$" "$PWD" "$created_at" ""
    start_rollout_monitor_if_needed "$$" "${TIDEY_WORKSPACE_ID:-}" "${TIDEY_PANEL_ID:-}" "$PWD" "$created_at" "$registry_file" "$session_id"

    if [[ "$emit_session_start_hook" == "1" && -n "${TIDEY_SOCKET_PATH:-}" && -n "${TIDEY_WORKSPACE_ID:-}" && -x "$HOOK_DIR/tidey" ]]; then
        "$HOOK_DIR/tidey" codex-hook session-start || true
    fi

    exec env TIDEY_CODEX_HOOKS_ENABLED=1 CODEX_HOME="$real_codex_home" "$real_codex" "$profile_flag" "$profile_name" "$@"
}

should_use_codex_app_server_runtime() {
    if [[ "${TIDEY_CODEX_APP_SERVER_DISABLE:-}" == "1" ]]; then
        return 1
    fi
    if ! is_app_server_runtime_command "$@"; then
        return 1
    fi
    if [[ -z "${TIDEY_SOCKET_PATH:-}" || ! -S "${TIDEY_SOCKET_PATH:-}" || -z "${TIDEY_WORKSPACE_ID:-}" ]]; then
        return 1
    fi
    return 0
}

run_codex_app_server_runtime() {
    local real_codex="$1"
    local real_codex_home="$2"
    local profile_flag="$3"
    local profile_name="$4"
    local sqlite_home="$5"
    local registry_file="$6"
    local session_id="$7"
    local created_at="$8"
    local rollout_path="$9"
    local thread_id="${10:-}"
    shift 10

    local socket_dir=""
    local socket_path=""
    local app_server_pid=""
    local remote_tui_pid=""
    local app_server_log=""
    local remote_status=0
    local socket_wait_attempts="${TIDEY_CODEX_APP_SERVER_SOCKET_WAIT_ATTEMPTS:-1200}"
    local socket_wait_interval="${TIDEY_CODEX_APP_SERVER_SOCKET_WAIT_INTERVAL:-0.05}"
    local socket_wait_iteration=0

    socket_dir="$(mktemp -d "${TMPDIR:-/tmp}/tidey-codex-app-server.XXXXXX")"
    socket_path="$socket_dir/app.sock"
    app_server_log="$socket_dir/app-server.log"

    cleanup_codex_app_server_artifacts() {
        if [[ -n "${remote_tui_pid:-}" ]]; then
            kill_pid_tree "$remote_tui_pid"
        fi
        if [[ -n "${app_server_pid:-}" ]]; then
            kill_pid_tree "$app_server_pid"
            wait "$app_server_pid" 2>/dev/null || true
        fi
        if [[ -n "${socket_path:-}" ]]; then
            kill_processes_matching_text "$socket_path"
        fi
        rm -f "${registry_file:-}"
        rm -rf "${socket_dir:-}"
    }

    cleanup_codex_app_server_runtime() {
        local status="${1:-$?}"
        trap - EXIT HUP INT TERM
        set +e
        cleanup_codex_app_server_artifacts
        exit "$status"
    }

    fallback_to_plain_codex() {
        local reason="$1"
        local emit_session_start_hook="$2"
        local fallback_log="$real_codex_home/.tmp/tidey-codex-app-server-startup-fallback.log"
        shift 2
        mkdir -p "$real_codex_home/.tmp" 2>/dev/null || true
        {
            printf 'reason=%s\n' "$reason"
            if [[ -s "${app_server_log:-}" ]]; then
                cat "$app_server_log"
            fi
        } > "$fallback_log" 2>/dev/null || true
        trap - EXIT HUP INT TERM
        cleanup_codex_app_server_artifacts
        launch_tracked_plain_codex_runtime "$real_codex" "$real_codex_home" "$profile_flag" "$profile_name" "$registry_file" "$session_id" "$created_at" "$emit_session_start_hook" "$@"
    }

    trap 'cleanup_codex_app_server_runtime "$?"' EXIT
    trap 'cleanup_codex_app_server_runtime 129' HUP
    trap 'cleanup_codex_app_server_runtime 130' INT
    trap 'cleanup_codex_app_server_runtime 143' TERM

    if ! [[ "$socket_wait_attempts" =~ ^[0-9]+$ ]] || [[ "$socket_wait_attempts" -lt 1 ]]; then
        socket_wait_attempts=1200
    fi

    env TIDEY_CODEX_HOOKS_ENABLED=1 CODEX_HOME="$real_codex_home" "$real_codex" app-server \
        -c "sqlite_home=$(toml_inline_string "$sqlite_home")" \
        --listen "unix://$socket_path" >"$app_server_log" 2>&1 &
    app_server_pid="$!"

    for socket_wait_iteration in $(seq 1 "$socket_wait_attempts"); do
        if [[ -S "$socket_path" ]]; then
            break
        fi
        if ! kill -0 "$app_server_pid" 2>/dev/null; then
            fallback_to_plain_codex "app-server exited before socket was ready" 1 "$@"
        fi
        sleep "$socket_wait_interval"
    done
    if [[ ! -S "$socket_path" ]]; then
        fallback_to_plain_codex "socket was not ready before timeout" 1 "$@"
    fi

    tidey_hydrate_tmux_pane_identity
    write_registry_file "$registry_file" "$TIDEY_WORKSPACE_ID" "$session_id" "${TIDEY_PANEL_ID:-}" "$$" "$PWD" "$created_at" "$rollout_path" "codex_app_server_starting" "$socket_path" "$app_server_pid" "" "$thread_id" "$thread_id"

    if [[ -n "${TIDEY_SOCKET_PATH:-}" && -n "${TIDEY_WORKSPACE_ID:-}" && -x "$HOOK_DIR/tidey" ]]; then
        "$HOOK_DIR/tidey" codex-hook session-start || true
    fi

    set +e
    env TIDEY_CODEX_HOOKS_ENABLED=1 CODEX_HOME="$real_codex_home" "$real_codex" --remote "unix://$socket_path" "$@" &
    remote_tui_pid="$!"
    tidey_hydrate_tmux_pane_identity
    write_registry_file "$registry_file" "$TIDEY_WORKSPACE_ID" "$session_id" "${TIDEY_PANEL_ID:-}" "$$" "$PWD" "$created_at" "$rollout_path" "codex_app_server" "$socket_path" "$app_server_pid" "$remote_tui_pid" "$thread_id" "$thread_id"
    wait "$remote_tui_pid"
    remote_status=$?
    remote_tui_pid=""
    set -e

    cleanup_codex_app_server_runtime "$remote_status"
}

initial_session_id() {
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen | tr '[:upper:]' '[:lower:]'
        return 0
    fi
    python3 - <<'PY'
import uuid
print(str(uuid.uuid4()))
PY
}

main() {
    local real_codex=""
    local real_codex_home=""
    local profile_identity=""
    local profile_name=""
    local sqlite_home=""
    local dispatch_script=""
    local created_at=""
    local session_id=""
    local app_server_runtime_session_id=""
    local app_server_runtime_thread_id=""
    local app_server_runtime_rollout_path=""
    local use_app_server_runtime=0
    local registry_file=""
    local profile_flag=""

    real_codex="$(find_real_codex)" || { echo "Error: codex not found in PATH" >&2; exit 127; }
    tidey_hydrate_tmux_runtime_environment
    if is_app_server_runtime_command "$@" &&
       [[ -n "${TMUX_PANE:-}" ]] &&
       [[ -n "${TIDEY_SOCKET_PATH:-}" && -S "${TIDEY_SOCKET_PATH:-}" ]] &&
       [[ -z "${TIDEY_WORKSPACE_ID:-}" || -z "${TIDEY_PANEL_ID:-}" ]]; then
        # Ordinary tmux projection is asynchronous. A shell created by SSH can
        # be attached to Tidey a few seconds before Bridge writes pane-scoped
        # identity. Wait for that authoritative context instead of silently
        # launching an untracked plain Codex process.
        tidey_wait_for_tmux_pane_identity || true
        tidey_hydrate_tmux_runtime_environment
    fi

    if [[ -z "${TIDEY_SOCKET_PATH:-}" || ! -S "${TIDEY_SOCKET_PATH:-}" || -z "${TIDEY_WORKSPACE_ID:-}" ]]; then
        exec "$real_codex" "$@"
    fi

    real_codex_home="$(resolve_real_codex_home)"
    profile_identity="$(codex_runtime_identity_from_env)"
    profile_name="$(stable_codex_profile_name "$profile_identity")"
    profile_flag="$(codex_profile_flag "$real_codex")"
    sqlite_home="$(stable_codex_sqlite_home "$real_codex_home" "$profile_identity")"
    dispatch_script="$HOOK_DIR/codex-hook-dispatch"
    merge_tidey_hooks_into_user_hooks "$real_codex_home" "$dispatch_script"
    write_tidey_profile_config "$real_codex_home" "$profile_name" "$sqlite_home" "$dispatch_script"

    created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    session_id="$(initial_session_id)"
    app_server_runtime_session_id="$(app_server_resume_session_id "$@" || true)"
    if should_use_codex_app_server_runtime "$@"; then
        use_app_server_runtime=1
        if [[ -n "$app_server_runtime_session_id" ]]; then
            app_server_runtime_thread_id="$app_server_runtime_session_id"
            app_server_runtime_rollout_path="$(codex_rollout_path_for_session_id "$real_codex_home" "$app_server_runtime_thread_id" || true)"
            if [[ -f "$app_server_runtime_rollout_path" && -r "$app_server_runtime_rollout_path" && -s "$app_server_runtime_rollout_path" ]]; then
                if codex_runtime_compatibility_allows_tracked_plain \
                    "$CODEX_RUNTIME_COMPATIBILITY_FILE" \
                    "$real_codex" \
                    "$app_server_runtime_thread_id" \
                    "$(id -u)"; then
                    use_app_server_runtime=0
                fi
            fi
        fi
    fi
    registry_file="$REGISTRY_ROOT/codex-$session_id.json"
    if [[ "$use_app_server_runtime" == "1" ]]; then
        cleanup_stale_app_server_registry_records
        run_codex_app_server_runtime "$real_codex" "$real_codex_home" "$profile_flag" "$profile_name" "$sqlite_home" "$registry_file" "$session_id" "$created_at" "$app_server_runtime_rollout_path" "$app_server_runtime_thread_id" "$@"
        exit $?
    fi

    launch_tracked_plain_codex_runtime "$real_codex" "$real_codex_home" "$profile_flag" "$profile_name" "$registry_file" "$session_id" "$created_at" 1 "$@"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
