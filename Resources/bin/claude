#!/usr/bin/env bash
# Tidey claude wrapper — injects hooks for notification and status tracking.
#
# When running inside a Tidey terminal (TIDEY_SOCKET_PATH is set and live),
# this wrapper intercepts `claude` invocations to inject --settings with hooks
# so that Claude Code events fire back into Tidey for notifications/status.
# Outside Tidey, it passes through to the real claude binary unchanged.

set -euo pipefail

REGISTRY_ROOT="$HOME/Library/Application Support/Tidey Remote Bridge/agent-sessions/claude"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
source "$HOOK_DIR/tidey-tmux-pane-identity"
# shellcheck source=/dev/null
source "$HOOK_DIR/claude-hook-journal-lifecycle"
# shellcheck source=/dev/null
source "$HOOK_DIR/claude-hook-argv-session-id"

json_escape() {
    local s="${1-}"
    s=${s//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    s=${s//$'\r'/\\r}
    s=${s//$'\t'/\\t}
    printf '%s' "$s"
}

build_tidey_browser_mcp_json() {
    local adapter_path="$1"
    local socket_path="$2"
    local workspace_id="$3"

    printf '{"mcpServers":{"tidey_browser":{"type":"stdio","command":"%s","args":[],"env":{"TIDEY_SOCKET_PATH":"%s","TIDEY_WORKSPACE_ID":"%s"}}}}' \
        "$(json_escape "$adapter_path")" \
        "$(json_escape "$socket_path")" \
        "$(json_escape "$workspace_id")"
}

tmux_pane_id_from_env() {
    if [[ -n "${TMUX_PANE:-}" ]]; then
        printf '%s' "$TMUX_PANE"
    fi
}

tmux_socket_path_from_env() {
    local tmux_env="${TMUX:-}"
    if [[ -n "$tmux_env" ]]; then
        printf '%s' "${tmux_env%%,*}"
    fi
}

registry_file_matches_owner() {
    local path="$1" pid="$2" workspace_id="$3" panel_id="$4"
    [[ -f "$path" ]] || return 1
    # Parse exact typed values: a numeric prefix or another panel is not this owner.
    [[ "$(/usr/bin/plutil -extract pid raw -expect integer -o - "$path" 2>/dev/null)" == "$pid" ]] || return 1
    [[ "$(/usr/bin/plutil -extract workspace_id raw -expect string -o - "$path" 2>/dev/null)" == "$workspace_id" ]] || return 1
    [[ "$(/usr/bin/plutil -extract panel_id raw -expect string -o - "$path" 2>/dev/null)" == "$panel_id" ]] || return 1
    [[ "$(/usr/bin/plutil -extract vendor raw -expect string -o - "$path" 2>/dev/null)" == claude ]] || return 1
    local session_id=""
    session_id="$(/usr/bin/plutil -extract session_id raw -expect string -o - "$path" 2>/dev/null)" || return 1
    [[ -n "$session_id" && "${path##*/}" == "claude-$session_id.json" ]]
}

remove_owned_registry_files() {
    local pid="$1" workspace_id="$2" panel_id="$3" path=""
    for path in "$REGISTRY_ROOT"/claude-*.json; do
        if registry_file_matches_owner "$path" "$pid" "$workspace_id" "$panel_id"; then
            rm -f "$path"
        fi
    done
}

write_registry_file() {
    local path="$1"
    local workspace_id="$2"
    local session_id="$3"
    local panel_id="$4"
    local pid="$5"
    local cwd="$6"
    local created_at="$7"
    local tmp_path=""
    local tmux_pane_id=""
    local tmux_socket_path=""
    local tmux_fields=""

    tmux_pane_id="$(tmux_pane_id_from_env)"
    tmux_socket_path="$(tmux_socket_path_from_env)"

    if [[ -n "$tmux_pane_id" ]]; then
        tmux_fields+=",\"tmux_pane_id\":\"$(json_escape "$tmux_pane_id")\""
    fi
    if [[ -n "$tmux_socket_path" ]]; then
        tmux_fields+=",\"tmux_socket_path\":\"$(json_escape "$tmux_socket_path")\""
    fi

    mkdir -p "$REGISTRY_ROOT"
    tmp_path="$(mktemp "$REGISTRY_ROOT/.claude-registry.XXXXXX")"
    {
        printf '{"version":1,"vendor":"claude","workspace_id":"%s","session_id":"%s","panel_id":"%s","pid":%s,"cwd":"%s","created_at":"%s"%s}\n' \
            "$(json_escape "$workspace_id")" \
            "$(json_escape "$session_id")" \
            "$(json_escape "$panel_id")" \
            "$pid" \
            "$(json_escape "$cwd")" \
            "$(json_escape "$created_at")" \
            "$tmux_fields" > "$tmp_path"
        mv -f "$tmp_path" "$path"
    } || {
        rm -f "$tmp_path"
        return 1
    }
}

find_registry_file_for_pid() {
    local pid="$1" workspace_id="$2" panel_id="$3" path="" matched=""
    for path in "$REGISTRY_ROOT"/claude-*.json; do
        if registry_file_matches_owner "$path" "$pid" "$workspace_id" "$panel_id"; then
            # Without a current SessionStart event, multiple aliases are ambiguous.
            [[ -z "$matched" ]] || return 1
            matched="$path"
        fi
    done
    [[ -n "$matched" ]] || return 1
    printf '%s' "$matched"
}

monitor_registry_file() {
    local pid="$1" workspace_id="$2" panel_id="$3"
    local registry_file="${7:-}"

    while kill -0 "$pid" 2>/dev/null; do
        if [[ -z "$registry_file" || ! -f "$registry_file" ]]; then
            registry_file="$(find_registry_file_for_pid "$pid" "$workspace_id" "$panel_id" || true)"
        fi
        # Bootstrap is written before Claude starts. Lifecycle hooks own all
        # later writes, including tmux metadata: repairing a retired file here
        # can resurrect the old UUID during or after SessionStart's handover.
        sleep 2
    done
    remove_owned_registry_files "$pid" "$workspace_id" "$panel_id"
}

shell_quote() {
    local s="${1-}"
    s=${s//\'/\'\\\'\'}
    printf "'%s'" "$s"
}

claude_hook_epoch_timestamp() {
    local timestamp=""

    # Current macOS /bin/date provides nanoseconds. Reject the literal %N
    # produced by older implementations instead of silently treating it as
    # a sortable timestamp.
    timestamp="$(/bin/date +%s%N 2>/dev/null || true)"
    case "$timestamp" in
        ''|*[!0-9]*) timestamp="" ;;
    esac
    if [[ -n "$timestamp" && "${#timestamp}" -lt 19 ]]; then
        timestamp=""
    fi

    # Keep older supported macOS versions high-resolution when their date(1)
    # lacks %N. These interpreters are fallbacks only, so the common launch
    # path does not pay their startup cost.
    if [[ -z "$timestamp" && -x /usr/bin/python3 ]]; then
        timestamp="$(/usr/bin/python3 -c 'import time; print(time.time_ns())' 2>/dev/null || true)"
        case "$timestamp" in
            ''|*[!0-9]*) timestamp="" ;;
        esac
        if [[ -n "$timestamp" && "${#timestamp}" -lt 19 ]]; then
            timestamp=""
        fi
    fi
    if [[ -z "$timestamp" && -x /usr/bin/perl ]]; then
        timestamp="$(/usr/bin/perl -MTime::HiRes=time -e 'printf "%.0f", time() * 1000000000' 2>/dev/null || true)"
        case "$timestamp" in
            ''|*[!0-9]*) timestamp="" ;;
        esac
        if [[ -n "$timestamp" && "${#timestamp}" -lt 19 ]]; then
            timestamp=""
        fi
    fi

    # Last-resort compatibility path. The lifecycle helper advances its
    # persisted monotonic counter when multiple wrappers observe this same
    # coarse value, so padding does not reintroduce same-second ambiguity.
    if [[ -z "$timestamp" ]]; then
        timestamp="$(/bin/date +%s 2>/dev/null || true)"
        case "$timestamp" in
            ''|*[!0-9]*) timestamp="0" ;;
        esac
        timestamp="${timestamp}000000000"
    fi

    printf '%s' "$timestamp"
}

build_hook_command() {
    local event="$1"
    local prefix="${2:-}"
    local dispatch_path="$HOOK_DIR/claude-hook-dispatch"
    local pane_helper_path="$HOOK_DIR/tidey-tmux-pane-identity"
    local script=""

    if [[ -n "$prefix" ]]; then
        script+="$prefix; "
    fi

    script+=". $(shell_quote "$pane_helper_path"); tidey_hydrate_tmux_pane_identity; "
    # Dispatch journals the typed event for the Remote Bridge lifecycle
    # (JSONL under the shared registry root) and forwards stdin to the
    # tidey CLI unchanged. The epoch token identifies THIS wrapper
    # instance so the Bridge can reject a retired wrapper's late events.
    # REGISTRY_ROOT is always passed so dispatch can lazily discover the
    # session id from the hook's own payload when it was unknown at
    # wrapper launch (implicit resume).
    script+="exec $(shell_quote "$dispatch_path") $(shell_quote "$event") $(shell_quote "${HOOK_JOURNAL_FILE:-}") $(shell_quote "${HOOK_JOURNAL_EPOCH:-}") $(shell_quote "$REGISTRY_ROOT")"

    printf '/bin/sh -c %s' "$(shell_quote "$script")"
}

# Find the real claude binary, skipping our own directory.
find_real_claude() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/claude" ]] && printf '%s' "$d/claude" && return 0
    done
    return 1
}

# Tidey Dev deliberately provides terminal UI without attaching agent
# lifecycle, Browser MCP, or Remote Bridge state to the production runtime.
if [[ "${TIDEY_DEV_SANDBOX:-}" == "1" ]]; then
    REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }
    exec "$REAL_CLAUDE" "$@"
fi

# A Tidey client may attach to a tmux pane whose shell was created earlier by
# SSH/Termius. Hydrate the currently available runtime context before deciding
# whether this invocation belongs to Tidey.
tidey_hydrate_tmux_runtime_environment

REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

# Pass through subcommands that don't support hooks.
case "${1:-}" in
    mcp|config|api-key) exec "$REAL_CLAUDE" "$@" ;;
esac

# Interactive Claude runtimes restored inside Tidey's app-owned tmux server can
# start before all pane options have been projected. Wait for the complete
# runtime context before deciding whether this is a Tidey-managed invocation;
# otherwise a healthy resumed Claude process is left without hooks or registry
# and Tidey Remote can only expose it as a plain terminal.
if [[ -n "${TMUX_PANE:-}" ]] &&
   { [[ "${TMUX:-}" == "$HOME/Library/Application Support/Tidey/Runtime/"* ]] ||
     [[ -n "${TIDEY_SOCKET_PATH:-}" && -S "${TIDEY_SOCKET_PATH:-}" ]]; } &&
   { [[ -z "${TIDEY_WORKSPACE_ID:-}" ]] ||
     [[ -z "${TIDEY_PANEL_ID:-}" ]] ||
     [[ -z "${TIDEY_SOCKET_PATH:-}" ]] ||
     [[ ! -S "${TIDEY_SOCKET_PATH:-}" ]]; }; then
    tidey_wait_for_tmux_runtime_context || true
    tidey_hydrate_tmux_runtime_environment
fi

# Pass through if not in a Tidey terminal or socket is unavailable.
if [[ -z "${TIDEY_SOCKET_PATH:-}" || ! -S "${TIDEY_SOCKET_PATH:-}" ]]; then
    exec "$REAL_CLAUDE" "$@"
fi

SESSION_ID=""
if ! SESSION_ID="$(claude_hook_find_explicit_session_id "$@")"; then
    if claude_hook_has_implicit_resume_flag "$@"; then
        # No trusted id ahead of time (picker, most-recent continuation,
        # non-UUID search term, or --fork-session): the actual session_id
        # is claimed dynamically from the first hook payload that reports
        # it (see claude-hook-dispatch).
        SESSION_ID=""
    else
        SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
        set -- --session-id "$SESSION_ID" "$@"
    fi
fi
tidey_hydrate_tmux_pane_identity

# Typed hook journal for the Remote Bridge three-state lifecycle. Only a
# session with a known id gets one (same condition as the registry file).
# The epoch token names THIS wrapper run: a resumed session's new wrapper
# gets a new epoch, so the Bridge can drop the old wrapper's late events.
HOOK_JOURNAL_FILE=""
HOOK_JOURNAL_EPOCH="$(claude_hook_allocate_epoch "$REGISTRY_ROOT" "$$" "$(claude_hook_epoch_timestamp)")"
HOOK_JOURNAL_EPOCH_MARKER=""
if [[ -n "$SESSION_ID" ]]; then
    mkdir -p "$REGISTRY_ROOT" 2>/dev/null || true
    HOOK_JOURNAL_FILE="$REGISTRY_ROOT/claude-hooks-${SESSION_ID}.jsonl"
    HOOK_JOURNAL_EPOCH_MARKER="$REGISTRY_ROOT/claude-hooks-${SESSION_ID}.epoch"
    # Durable handoff: claim ownership of the shared journal by writing OUR
    # epoch to the marker LAST. A resumed session's new wrapper overwrites
    # it; this wrapper's later cleanup then sees a marker that no longer
    # matches and skips deletion — the new wrapper's journal/counter/seqlock
    # survive an old wrapper's teardown race.
    claude_hook_journal_claim "$HOOK_JOURNAL_EPOCH_MARKER" "$HOOK_JOURNAL_EPOCH"
fi

# Build hooks settings JSON.
# Claude Code merges --settings additively with the user's own settings.json.
SESSION_HOOK_PREFIX="export TIDEY_CLAUDE_WRAPPER_PID=$(shell_quote "$$"); export TIDEY_CLAUDE_WRAPPER_CWD=$(shell_quote "$PWD")"
SESSION_START_CMD="$(json_escape "$(build_hook_command "session-start" "$SESSION_HOOK_PREFIX")")"
NOTIFICATION_PERMISSION_CMD="$(json_escape "$(build_hook_command "notification-permission")")"
NOTIFICATION_IDLE_CMD="$(json_escape "$(build_hook_command "notification-idle")")"
PERMISSION_REQUEST_CMD="$(json_escape "$(build_hook_command "permission-request")")"
STOP_CMD="$(json_escape "$(build_hook_command "stop")")"
SESSION_END_CMD="$(json_escape "$(build_hook_command "session-end" "$SESSION_HOOK_PREFIX")")"
PROMPT_SUBMIT_CMD="$(json_escape "$(build_hook_command "prompt-submit")")"
POST_TOOL_USE_CMD="$(json_escape "$(build_hook_command "post-tool-use")")"
# Typed notification matchers: ONLY permission_prompt implies needs-input;
# idle_prompt is idle; every other notification changes no state (so it is
# not registered). PermissionRequest is the authoritative permission opener.
# PostToolUse is the Mac-side permission RESOLUTION signal: any tool
# actually running proves its permission (if any) was decided, mirroring
# the Bridge's tool_result-correlated resolve.
HOOKS_JSON="{\"hooks\":{\"SessionStart\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$SESSION_START_CMD\",\"timeout\":10}]}],\"Notification\":[{\"matcher\":\"permission_prompt\",\"hooks\":[{\"type\":\"command\",\"command\":\"$NOTIFICATION_PERMISSION_CMD\",\"timeout\":10}]},{\"matcher\":\"idle_prompt\",\"hooks\":[{\"type\":\"command\",\"command\":\"$NOTIFICATION_IDLE_CMD\",\"timeout\":10}]}],\"PermissionRequest\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$PERMISSION_REQUEST_CMD\",\"timeout\":10}]}],\"Stop\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$STOP_CMD\",\"timeout\":10}]}],\"SessionEnd\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$SESSION_END_CMD\",\"timeout\":1}]}],\"UserPromptSubmit\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$PROMPT_SUBMIT_CMD\",\"timeout\":10}]}],\"PostToolUse\":[{\"matcher\":\"\",\"hooks\":[{\"type\":\"command\",\"command\":\"$POST_TOOL_USE_CMD\",\"timeout\":10}]}]}}"

REGISTRY_FILE=""
MONITOR_PID=""
if [[ -n "${TIDEY_WORKSPACE_ID:-}" && -n "$SESSION_ID" ]]; then
    REGISTRY_FILE="$REGISTRY_ROOT/claude-${SESSION_ID}.json"
    CREATED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    write_registry_file "$REGISTRY_FILE" "$TIDEY_WORKSPACE_ID" "$SESSION_ID" "${TIDEY_PANEL_ID:-}" "$$" "$PWD" "$CREATED_AT"
else
    CREATED_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
fi

if [[ -n "${TIDEY_WORKSPACE_ID:-}" ]]; then
    monitor_registry_file "$$" "$TIDEY_WORKSPACE_ID" "${TIDEY_PANEL_ID:-}" "$PWD" "$CREATED_AT" "$SESSION_ID" "$REGISTRY_FILE" &
    MONITOR_PID="$!"
fi

cleanup() {
    if [[ -n "${MONITOR_PID:-}" ]]; then
        kill "$MONITOR_PID" 2>/dev/null || true
        wait "$MONITOR_PID" 2>/dev/null || true
    fi
    if [[ -n "${TIDEY_WORKSPACE_ID:-}" ]]; then
        remove_owned_registry_files "$$" "$TIDEY_WORKSPACE_ID" "${TIDEY_PANEL_ID:-}"
    fi
    if [[ -n "${HOOK_JOURNAL_FILE:-}" ]]; then
        # A newer wrapper's later claim on the marker is respected — its
        # journal, counter, and seqlock are NOT ours to delete.
        claude_hook_journal_cleanup "$HOOK_JOURNAL_FILE" "$HOOK_JOURNAL_EPOCH_MARKER" "$HOOK_JOURNAL_EPOCH" || true
    fi
}

trap cleanup EXIT

if [[ -n "${TIDEY_WORKSPACE_ID:-}" && -S "${TIDEY_SOCKET_PATH:-}" ]]; then
    TIDEY_BROWSER_MCP_JSON="$(build_tidey_browser_mcp_json \
        "$HOOK_DIR/tidey-browser-mcp" \
        "$TIDEY_SOCKET_PATH" \
        "$TIDEY_WORKSPACE_ID")"
    "$REAL_CLAUDE" --settings "$HOOKS_JSON" --mcp-config "$TIDEY_BROWSER_MCP_JSON" "$@"
else
    "$REAL_CLAUDE" --settings "$HOOKS_JSON" "$@"
fi
